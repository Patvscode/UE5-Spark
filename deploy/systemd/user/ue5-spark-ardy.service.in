[Unit]
Description=UE5-Spark project-owned ARDY motion service
PartOf=ue5-spark-digital-human.target
Before=ue5-spark-ardy-ready.service
StartLimitIntervalSec=300
StartLimitBurst=2

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
ExecStartPre=/usr/bin/python3 @PROJECT_ROOT@/scripts/check-spark-stack-preflight.py --minimum-available-gib 20
ExecStart=@PROJECT_ROOT@/scripts/run-ardy-open-text-container.sh @MODELS_ROOT@ @ENCODER_CACHE_ROOT@
ExecStop=-/usr/bin/docker stop --time 20 ue5-spark-ardy
Restart=no
TimeoutStartSec=60s
TimeoutStopSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
